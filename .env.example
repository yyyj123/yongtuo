APP_ENV=local
DB_HOST=mysql
# Plan contract: internal MySQL port. Current Compose JDBC URL is fixed at 3306;
# changing DB_PORT alone does not change connectivity or publish a host port.
DB_PORT=3306
DB_NAME=yongtuo
DB_USER=yongtuo
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
JWT_ACCESS_SECRET=local-only-access-secret-change-before-non-local-use-2026
JWT_REFRESH_SECRET=local-only-refresh-secret-change-before-non-local-use-2026
OBJECT_STORAGE_PROVIDER=disabled
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
# Reserved site-address contracts; Phase 1 does not consume these three values.
PUBLIC_SITE_URL=http://localhost
ADMIN_SITE_URL=http://localhost/manage/
API_BASE_URL=http://localhost/api/v1
# Actual Nuxt public runtime value passed by Compose; not derived from API_BASE_URL.
# Relative /api/v1 uses the same-origin Nginx proxy in the browser.
NUXT_PUBLIC_API_BASE=/api/v1

# Phase 5: comma-separated approved public image hosts; rebuild web after changes.
NUXT_IMAGE_DOMAINS=
